# VAPI Configuration
# Get your API key from https://vapi.ai
EXPO_PUBLIC_VAPI_API_KEY=your_vapi_api_key_here

# Practice Mode
# Set to 'live' to use real VAPI calls (requires valid API key)
# Set to 'mock' to use simulated practice sessions (no API calls, no costs)
# If not set, defaults to 'live' when VAPI is configured, 'mock' otherwise
# EXPO_PUBLIC_PRACTICE_MODE=mock